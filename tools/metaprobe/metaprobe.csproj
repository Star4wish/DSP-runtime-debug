<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Metadata-only type explorer for the game / mod assemblies.

    Reads type + member *names and signatures* with Mono.Cecil (no runtime load),
    so it works without Unity and without a matching CLR. Printing member names is
    explicitly allowed by dsp-wiki; do NOT paste decompiled method bodies anywhere.

    Mono.Cecil comes from NuGet (not a vendored dll in the repo): the repo ships no
    third-party binaries. Restore needs a network connection the first time.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>metaprobe</AssemblyName>
    <RootNamespace>MetaProbe</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
